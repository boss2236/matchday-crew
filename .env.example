# Copy to .env and fill in ONE provider. Without any, the crew runs on templates.

# --- Option A: Microsoft Foundry (Azure OpenAI compatible deployment) ---
# FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com
# FOUNDRY_DEPLOYMENT=gpt-4o-mini
# FOUNDRY_API_KEY=

# --- Option C: GitHub Copilot, through the GitHub Copilot SDK ---
# Uses your Copilot plan (logged-in GitHub account); every prompt counts against
# it, so use it to pre-generate lines (npm run prewarm). One-time setup:
#   npm install @github/copilot-sdk
# Test with one prompt: node scripts/copilot-check.ts
# LLM_PROVIDER=copilot
# COPILOT_MODEL=gpt-5-mini
# COPILOT_CLI_PATH=        set to `which copilot` if the SDK's bundled runtime crashes
# COPILOT_GITHUB_TOKEN=    optional; otherwise your gh / Copilot CLI login

# --- Option B: any OpenAI-compatible API (Groq, Gemini, local Ollama, ...) ---
# Groq free tier:
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# Google Gemini free tier instead:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-flash-latest

# Reasoning models (gpt-oss, Gemini) think before answering: keep effort low and
# give them token headroom so the JSON is not cut off.
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=1500
# Free tiers rate limit hard; the client waits and retries as the server asks.
LLM_RETRIES=10

# Optional: audiences' languages (analyst, casual) and the casual fan's club
# CREW_LANGUAGES=English,Arabic
# CREW_FAV_CLUB=harbour

# --- Azure AI Translator (free F0 tier is plenty). Localises template lines. ---
# AZURE_TRANSLATOR_KEY=
# AZURE_TRANSLATOR_REGION=westeurope

# --- Azure AI Speech (free F0 tier). Voice commentary with neural voices. ---
# Without it the app uses the browser's own voice.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=qatarcentral

# --- Azure AI Content Safety (free F0 tier). The Safety agent screens model lines. ---
# AZURE_CONTENT_SAFETY_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# AZURE_CONTENT_SAFETY_KEY=
# CONTENT_SAFETY_MAX_SEVERITY=2

# --- Azure Application Insights (free tier). Requests, model calls, sessions, errors. ---
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=https://...

# --- Response cache (data/llm-cache/) ---
# on (default): read and write. read: never write (used in the container). off: no cache.
# LLM_CACHE=on

# --- Server ---
# PORT=3000
# MAX_LIVE_SESSIONS=4
