# Copy to .env and fill in ONE provider. Without any, the crew runs on templates.

# --- Option A: Microsoft Foundry (Azure OpenAI compatible deployment) ---
# FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com
# FOUNDRY_DEPLOYMENT=gpt-4o-mini
# FOUNDRY_API_KEY=

# --- Option B: any OpenAI-compatible API (Groq, Gemini, local Ollama, ...) ---
# Groq free tier:
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# Google Gemini free tier instead:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-flash-latest

# Reasoning models (gpt-oss, Gemini) think before answering: keep effort low and
# give them token headroom so the JSON is not cut off.
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=1500
# Free tiers rate limit hard; the client waits and retries as the server asks.
LLM_RETRIES=10

# Optional: audiences' languages (analyst, casual) and the casual fan's club
# CREW_LANGUAGES=English,Arabic
# CREW_FAV_CLUB=harbour

# --- Azure AI Translator (free F0 tier is plenty). Localises template lines. ---
# AZURE_TRANSLATOR_KEY=
# AZURE_TRANSLATOR_REGION=westeurope

# --- Response cache (data/llm-cache/) ---
# on (default): read and write. read: never write (used in the container). off: no cache.
# LLM_CACHE=on

# --- Server ---
# PORT=3000
# MAX_LIVE_SESSIONS=4
